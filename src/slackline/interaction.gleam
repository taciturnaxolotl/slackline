    codec.optional("options", it.options, codec.list(dialog_option_to_json)),
    codec.optional(
      "option_groups",
      it.option_groups,
      codec.list(dialog_option_group_to_json),
    ),
  ])
}

/// Legacy: a dialog select option. Dialogs use `label`, not `text`.
pub type DialogOption {
  DialogOption(
    /// A user-facing label, 75 characters maximum.
    label: String,
    /// The value sent to the app, 75 characters maximum.
    value: String,
  )
}

/// Decodes `DialogOption` from json.
pub fn dialog_option_decoder() -> decode.Decoder(DialogOption) {
  use v_label <- decode.field("label", decode.string)
  use v_value <- decode.field("value", decode.string)
  decode.success(DialogOption(label: v_label, value: v_value))
}

/// Encodes `DialogOption` as json.
pub fn dialog_option_to_json(it: DialogOption) -> json.Json {
  codec.object([
    codec.field("label", json.string(it.label)),
    codec.field("value", json.string(it.value)),
  ])
}

/// Legacy: a group of dialog select options.
pub type DialogOptionGroup {
  DialogOptionGroup(
    /// A user-facing label for the group, 75 characters maximum.
    label: String,
    /// The options in the group.
    options: List(DialogOption),
  )
}

/// Decodes `DialogOptionGroup` from json.
pub fn dialog_option_group_decoder() -> decode.Decoder(DialogOptionGroup) {
  use v_label <- decode.field("label", decode.string)
  use v_options <- decode.field(
    "options",
    decode.list(decode.recursive(dialog_option_decoder)),
  )
  decode.success(DialogOptionGroup(label: v_label, options: v_options))
}

/// Encodes `DialogOptionGroup` as json.
pub fn dialog_option_group_to_json(it: DialogOptionGroup) -> json.Json {
  codec.object([
    codec.field("label", json.string(it.label)),
    codec.field("options", json.array(it.options, dialog_option_to_json)),
  ])
}

/// Legacy: the body an app returns to reject a `dialog_submission`.
pub type DialogErrorsResponse {
  DialogErrorsResponse(errors: List(DialogError))
}

/// Decodes `DialogErrorsResponse` from json.
pub fn dialog_errors_response_decoder() -> decode.Decoder(DialogErrorsResponse) {
