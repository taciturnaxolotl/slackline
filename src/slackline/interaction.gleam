/// Encodes `DialogErrorsResponse` as json.
pub fn dialog_errors_response_to_json(it: DialogErrorsResponse) -> json.Json {
  codec.object([
    codec.field("errors", json.array(it.errors, dialog_error_to_json)),
  ])
