}

/// Decodes `DialogError` from json.
pub fn dialog_error_decoder() -> decode.Decoder(DialogError) {
  use v_name <- decode.field("name", decode.string)
  use v_error <- decode.field("error", decode.string)
  decode.success(DialogError(name: v_name, error: v_error))
