/// An interaction payload, dispatched on `type`. Each variant wraps the
/// payload record, so handlers can take exactly the payload they handle.
pub type Interaction {
  BlockActions(BlockActionsPayload)
  BlockSuggestion(BlockSuggestionPayload)
  ViewSubmission(ViewSubmissionPayload)
  ViewClosed(ViewClosedPayload)
  GlobalShortcut(GlobalShortcutPayload)
  MessageShortcut(MessageShortcutPayload)
  InteractiveMessage(InteractiveMessagePayload)
  DialogSubmission(DialogSubmissionPayload)
  DialogCancellation(DialogCancellationPayload)
  DialogSuggestion(DialogSuggestionPayload)
  /// A `type` that this version of slackline does not know. `raw` holds the
  /// full json.
  UnknownInteraction(type_: String, raw: value.Value)
}

/// Decodes `Interaction` from json. The `type` field selects the variant.
pub fn interaction_decoder() -> decode.Decoder(Interaction) {
  use tag <- decode.optional_field("type", "", decode.string)
  case tag {
    "block_actions" ->
      decode.map(decode.recursive(block_actions_payload_decoder), BlockActions)
    "block_suggestion" ->
      decode.map(
        decode.recursive(block_suggestion_payload_decoder),
        BlockSuggestion,
      )
    "view_submission" ->
      decode.map(
        decode.recursive(view_submission_payload_decoder),
        ViewSubmission,
      )
    "view_closed" ->
      decode.map(decode.recursive(view_closed_payload_decoder), ViewClosed)
    "shortcut" ->
      decode.map(
        decode.recursive(global_shortcut_payload_decoder),
        GlobalShortcut,
      )
    "message_action" ->
      decode.map(
        decode.recursive(message_shortcut_payload_decoder),
        MessageShortcut,
      )
    "interactive_message" ->
      decode.map(
        decode.recursive(interactive_message_payload_decoder),
        InteractiveMessage,
      )
    "dialog_submission" ->
      decode.map(
        decode.recursive(dialog_submission_payload_decoder),
        DialogSubmission,
      )
    "dialog_cancellation" ->
      decode.map(
        decode.recursive(dialog_cancellation_payload_decoder),
        DialogCancellation,
      )
    "dialog_suggestion" ->
      decode.map(
        decode.recursive(dialog_suggestion_payload_decoder),
        DialogSuggestion,
      )
    _ -> decode.map(value.decoder(), UnknownInteraction(type_: tag, raw: _))
  }
}

/// Encodes `Interaction` as json.
pub fn interaction_to_json(it: Interaction) -> json.Json {
  case it {
    BlockActions(inner) -> block_actions_payload_to_json(inner)
    BlockSuggestion(inner) -> block_suggestion_payload_to_json(inner)
    ViewSubmission(inner) -> view_submission_payload_to_json(inner)
    ViewClosed(inner) -> view_closed_payload_to_json(inner)
    GlobalShortcut(inner) -> global_shortcut_payload_to_json(inner)
    MessageShortcut(inner) -> message_shortcut_payload_to_json(inner)
    InteractiveMessage(inner) -> interactive_message_payload_to_json(inner)
    DialogSubmission(inner) -> dialog_submission_payload_to_json(inner)
    DialogCancellation(inner) -> dialog_cancellation_payload_to_json(inner)
    DialogSuggestion(inner) -> dialog_suggestion_payload_to_json(inner)
    UnknownInteraction(raw:, ..) -> value.to_json(raw)
  }
}

