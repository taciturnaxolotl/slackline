/// Legacy: an action from an interactive message attachment.
pub type LegacyAction {
  LegacyAction(
    /// The `name` set on the originating action.
    name: Option(String),
    /// The `value` set on the originating button.
    value: Option(String),
    /// `button` or `select`.
    action_type: Option(String),
    /// For message menus, the selected option.
    selected_options: Option(List(LegacySelectedOption)),
  )
}

/// Decodes `LegacyAction` from json.
pub fn legacy_action_decoder() -> decode.Decoder(LegacyAction) {
  use v_name <- codec.optional_field("name", decode.string)
  use v_value <- codec.optional_field("value", decode.string)
  use v_action_type <- codec.optional_field("type", decode.string)
  use v_selected_options <- codec.optional_field(
    "selected_options",
    decode.list(decode.recursive(legacy_selected_option_decoder)),
  )
  decode.success(LegacyAction(
    name: v_name,
    value: v_value,
    action_type: v_action_type,
    selected_options: v_selected_options,
  ))
}

/// Encodes `LegacyAction` as json.
pub fn legacy_action_to_json(it: LegacyAction) -> json.Json {
  codec.object([
    codec.optional("name", it.name, json.string),
    codec.optional("value", it.value, json.string),
    codec.optional("type", it.action_type, json.string),
    codec.optional(
      "selected_options",
      it.selected_options,
      codec.list(legacy_selected_option_to_json),
    ),
  ])
}

/// Legacy: an option chosen from a message menu.
pub type LegacySelectedOption {
  LegacySelectedOption(value: String)
}

/// Decodes `LegacySelectedOption` from json.
pub fn legacy_selected_option_decoder() -> decode.Decoder(LegacySelectedOption) {
  use v_value <- decode.field("value", decode.string)
  decode.success(LegacySelectedOption(value: v_value))
}

/// Encodes `LegacySelectedOption` as json.
pub fn legacy_selected_option_to_json(it: LegacySelectedOption) -> json.Json {
  codec.object([
    codec.field("value", json.string(it.value)),
  ])
}

/// The body an app returns to a `view_submission` payload, on
/// `response_action`.
/// <https://docs.slack.dev/surfaces/modals#updating_response>
pub type ViewSubmissionResponse {
  /// Show validation errors, keyed by the `block_id` of the input block.
  ErrorsResponse(errors: dict.Dict(String, String))
  /// Replace the submitted view.
  UpdateResponse(view: view.View)
  /// Push a new view onto the stack.
  PushResponse(view: view.View)
  /// Close every view in the stack.
  ClearResponse
  /// A `response_action` that this version of slackline does not know. `raw`
  /// holds the full json.
  UnknownViewSubmissionResponse(response_action: String, raw: value.Value)
}

/// Decodes `ViewSubmissionResponse` from json. The `response_action` field selects the variant.
pub fn view_submission_response_decoder() -> decode.Decoder(
  ViewSubmissionResponse,
) {
  use tag <- decode.optional_field("response_action", "", decode.string)
  case tag {
    "errors" -> {
      use v_errors <- decode.field(
        "errors",
        decode.dict(decode.string, decode.string),
      )
      decode.success(ErrorsResponse(errors: v_errors))
    }
    "update" -> {
      use v_view <- decode.field("view", view.view_decoder())
      decode.success(UpdateResponse(view: v_view))
    }
    "push" -> {
      use v_view <- decode.field("view", view.view_decoder())
      decode.success(PushResponse(view: v_view))
    }
    "clear" -> decode.success(ClearResponse)
    _ ->
      decode.map(value.decoder(), UnknownViewSubmissionResponse(
        response_action: tag,
        raw: _,
      ))
  }
}

/// Encodes `ViewSubmissionResponse` as json.
pub fn view_submission_response_to_json(
  it: ViewSubmissionResponse,
) -> json.Json {
  case it {
    ErrorsResponse(errors: v_errors) ->
      codec.object([
        codec.field("response_action", json.string("errors")),
        codec.field("errors", json.dict(v_errors, fn(key) { key }, json.string)),
      ])
    UpdateResponse(view: v_view) ->
      codec.object([
        codec.field("response_action", json.string("update")),
        codec.field("view", view.view_to_json(v_view)),
      ])
    PushResponse(view: v_view) ->
      codec.object([
        codec.field("response_action", json.string("push")),
        codec.field("view", view.view_to_json(v_view)),
      ])
    ClearResponse ->
      codec.object([
        codec.field("response_action", json.string("clear")),
      ])
    UnknownViewSubmissionResponse(raw:, ..) -> value.to_json(raw)
  }
}

/// The body an app returns to a `block_suggestion` payload. Send either
/// `options` or `option_groups`, at most 100 of either.
/// <https://docs.slack.dev/reference/block-kit/block-elements/select-menu-element#external_select>
pub type OptionsResponse {
  OptionsResponse(
    options: Option(List(block.SelectOption)),
    option_groups: Option(List(block.OptionGroup)),
  )
}

/// Decodes `OptionsResponse` from json.
pub fn options_response_decoder() -> decode.Decoder(OptionsResponse) {
  use v_options <- codec.optional_field(
    "options",
    decode.list(block.select_option_decoder()),
  )
  use v_option_groups <- codec.optional_field(
    "option_groups",
    decode.list(block.option_group_decoder()),
  )
  decode.success(OptionsResponse(
    options: v_options,
    option_groups: v_option_groups,
  ))
}

/// Encodes `OptionsResponse` as json.
pub fn options_response_to_json(it: OptionsResponse) -> json.Json {
  codec.object([
    codec.optional(
      "options",
      it.options,
      codec.list(block.select_option_to_json),
    ),
    codec.optional(
      "option_groups",
      it.option_groups,
      codec.list(block.option_group_to_json),
    ),
  ])
}

/// Legacy: the body an app returns to a `dialog_suggestion` payload.
pub type DialogOptionsResponse {
  DialogOptionsResponse(
    options: Option(List(DialogOption)),
    option_groups: Option(List(DialogOptionGroup)),
  )
}

/// Decodes `DialogOptionsResponse` from json.
pub fn dialog_options_response_decoder() -> decode.Decoder(
  DialogOptionsResponse,
) {
  use v_options <- codec.optional_field(
    "options",
    decode.list(decode.recursive(dialog_option_decoder)),
  )
  use v_option_groups <- codec.optional_field(
    "option_groups",
    decode.list(decode.recursive(dialog_option_group_decoder)),
  )
  decode.success(DialogOptionsResponse(
    options: v_options,
    option_groups: v_option_groups,
  ))
}

/// Encodes `DialogOptionsResponse` as json.
pub fn dialog_options_response_to_json(it: DialogOptionsResponse) -> json.Json {
