/// Where a `response_url` message is shown.
pub type ResponseType {
  /// Visible to everyone in the conversation.
  InChannel
  /// Visible only to the user who interacted (the default).
  Ephemeral
}

/// The json string of `ResponseType`.
pub fn response_type_to_string(it: ResponseType) -> String {
  case it {
    InChannel -> "in_channel"
    Ephemeral -> "ephemeral"
  }
}

/// Parses `ResponseType` from its json string.
pub fn response_type_from_string(string: String) -> Result(ResponseType, Nil) {
  case string {
    "in_channel" -> Ok(InChannel)
    "ephemeral" -> Ok(Ephemeral)
    _ -> Error(Nil)
  }
}

/// Decodes `ResponseType` from a json string.
pub fn response_type_decoder() -> decode.Decoder(ResponseType) {
  use string <- decode.then(decode.string)
  case response_type_from_string(string) {
    Ok(parsed) -> decode.success(parsed)
    Error(Nil) -> decode.failure(InChannel, "ResponseType")
  }
}

/// Encodes `ResponseType` as a json string.
pub fn response_type_to_json(it: ResponseType) -> json.Json {
  json.string(response_type_to_string(it))
}

/// A message posted to a `response_url`, or returned in the body of a slash
/// command response.
/// <https://docs.slack.dev/interactivity/handling-user-interaction#message_responses>
pub type ResponseMessage {
  ResponseMessage(
    /// The message text. Used as the fallback when `blocks` are present.
    text: Option(String),
    /// Block Kit blocks.
    blocks: Option(List(block.Block)),
    /// Legacy secondary attachments.
    attachments: Option(List(attachment.Attachment)),
    /// `in_channel` or `ephemeral` (the default).
    response_type: Option(ResponseType),
    /// Replace the message the interaction came from.
    replace_original: Option(Bool),
    /// Delete the message the interaction came from. Not supported for slash
    /// commands.
    delete_original: Option(Bool),
    /// Post as a reply in this thread (with `response_type: in_channel`).
    thread_ts: Option(String),
    /// Whether `text` uses mrkdwn formatting.
    mrkdwn: Option(Bool),
  )
}

/// Decodes `ResponseMessage` from json.
pub fn response_message_decoder() -> decode.Decoder(ResponseMessage) {
  use v_text <- codec.optional_field("text", decode.string)
  use v_blocks <- codec.optional_field(
    "blocks",
    decode.list(block.block_decoder()),
  )
  use v_attachments <- codec.optional_field(
    "attachments",
    decode.list(attachment.attachment_decoder()),
  )
  use v_response_type <- codec.optional_field(
    "response_type",
    response_type_decoder(),
  )
  use v_replace_original <- codec.optional_field(
    "replace_original",
    decode.bool,
  )
  use v_delete_original <- codec.optional_field("delete_original", decode.bool)
  use v_thread_ts <- codec.optional_field("thread_ts", decode.string)
  use v_mrkdwn <- codec.optional_field("mrkdwn", decode.bool)
  decode.success(ResponseMessage(
    text: v_text,
    blocks: v_blocks,
    attachments: v_attachments,
    response_type: v_response_type,
    replace_original: v_replace_original,
    delete_original: v_delete_original,
    thread_ts: v_thread_ts,
    mrkdwn: v_mrkdwn,
  ))
}

/// Encodes `ResponseMessage` as json.
pub fn response_message_to_json(it: ResponseMessage) -> json.Json {
  codec.object([
    codec.optional("text", it.text, json.string),
    codec.optional("blocks", it.blocks, codec.list(block.block_to_json)),
    codec.optional(
      "attachments",
      it.attachments,
      codec.list(attachment.attachment_to_json),
    ),
    codec.optional("response_type", it.response_type, response_type_to_json),
    codec.optional("replace_original", it.replace_original, json.bool),
    codec.optional("delete_original", it.delete_original, json.bool),
    codec.optional("thread_ts", it.thread_ts, json.string),
    codec.optional("mrkdwn", it.mrkdwn, json.bool),
  ])
}

/// A `view_submission` response that shows `errors` on the input blocks,
/// given as `#(block_id, message)` pairs.
pub fn errors(errors: List(#(String, String))) -> ViewSubmissionResponse {
  ErrorsResponse(errors: dict.from_list(errors))
}

/// A `view_submission` response that replaces the submitted view.
pub fn update(view: view.View) -> ViewSubmissionResponse {
  UpdateResponse(view:)
}

/// A `view_submission` response that pushes a new view onto the stack.
pub fn push(view: view.View) -> ViewSubmissionResponse {
  PushResponse(view:)
}

/// A `view_submission` response that closes every view in the stack.
pub fn clear() -> ViewSubmissionResponse {
  ClearResponse
}

/// A `block_suggestion` response listing options.
pub fn options(options: List(block.SelectOption)) -> OptionsResponse {
  OptionsResponse(options: Some(options), option_groups: None)
}

/// A `block_suggestion` response listing option groups.
pub fn option_groups(groups: List(block.OptionGroup)) -> OptionsResponse {
  OptionsResponse(options: None, option_groups: Some(groups))
}

/// An empty `response_url` message. Set fields with record update syntax.
pub fn response_message() -> ResponseMessage {
  ResponseMessage(
    text: None,
    blocks: None,
    attachments: None,
    response_type: None,
    replace_original: None,
    delete_original: None,
    thread_ts: None,
    mrkdwn: None,
  )
}

/// A text message only the user who interacted can see.
pub fn ephemeral(text: String) -> ResponseMessage {
  ResponseMessage(
    ..response_message(),
    text: Some(text),
    response_type: Some(Ephemeral),
  )
}

/// A text message everyone in the conversation can see.
pub fn in_channel(text: String) -> ResponseMessage {
  ResponseMessage(
    ..response_message(),
    text: Some(text),
    response_type: Some(InChannel),
  )
}

/// A `response_url` message that deletes the source message.
pub fn delete_original() -> ResponseMessage {
  ResponseMessage(..response_message(), delete_original: Some(True))
}

/// Parses the json in the `payload` form field of an interactivity request.
pub fn parse(payload: String) -> Result(Interaction, json.DecodeError) {
  json.parse(payload, interaction_decoder())
}

/// Decodes the `payload` field of a Socket Mode `interactive` envelope.
pub fn envelope_payload_decoder() -> decode.Decoder(Interaction) {
  decode.at(["payload"], interaction_decoder())
}

/// The `action_id` of a block action. For an action type that this version
/// of slackline does not know, it reads `action_id` from the raw json.
pub fn action_id(action: BlockAction) -> Option(String) {
  case action {
    ButtonAction(action_id:, ..)
    | WorkflowButtonAction(action_id:, ..)
    | IconButtonAction(action_id:, ..)
    | FeedbackButtonsAction(action_id:, ..)
    | OverflowAction(action_id:, ..)
    | CheckboxesAction(action_id:, ..)
    | RadioButtonsAction(action_id:, ..)
    | StaticSelectAction(action_id:, ..)
    | ExternalSelectAction(action_id:, ..)
    | UsersSelectAction(action_id:, ..)
    | ConversationsSelectAction(action_id:, ..)
    | ChannelsSelectAction(action_id:, ..)
    | MultiStaticSelectAction(action_id:, ..)
    | MultiExternalSelectAction(action_id:, ..)
    | MultiUsersSelectAction(action_id:, ..)
    | MultiConversationsSelectAction(action_id:, ..)
    | MultiChannelsSelectAction(action_id:, ..)
    | DatepickerAction(action_id:, ..)
    | TimepickerAction(action_id:, ..)
    | DatetimepickerAction(action_id:, ..)
    | PlainTextInputAction(action_id:, ..)
    | EmailTextInputAction(action_id:, ..)
    | UrlTextInputAction(action_id:, ..)
    | NumberInputAction(action_id:, ..)
    | RichTextInputAction(action_id:, ..) -> Some(action_id)
    UnknownBlockAction(raw:, ..) ->
      case value.string_field(raw, "action_id") {
        Ok(id) -> Some(id)
        Error(Nil) -> None
      }
  }
}
