/// Encodes `View` as json.
pub fn view_to_json(it: View) -> json.Json {
  codec.object([
    codec.field("type", view_type_to_json(it.view_type)),
    codec.field("blocks", json.array(it.blocks, block.block_to_json)),
    codec.optional("title", it.title, block.plain_text_to_json),
