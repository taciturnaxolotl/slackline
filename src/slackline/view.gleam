    codec.optional("submit", it.submit, block.plain_text_to_json),
    codec.optional("private_metadata", it.private_metadata, json.string),
    codec.optional("callback_id", it.callback_id, json.string),
    codec.optional("clear_on_close", it.clear_on_close, json.bool),
    codec.optional("notify_on_close", it.notify_on_close, json.bool),
    codec.optional("external_id", it.external_id, json.string),
    codec.optional("submit_disabled", it.submit_disabled, json.bool),
    codec.optional("id", it.id, json.string),
    codec.optional("team_id", it.team_id, json.string),
    codec.optional("state", it.state, view_state_to_json),
    codec.optional("hash", it.hash, json.string),
    codec.optional("previous_view_id", it.previous_view_id, json.string),
    codec.optional("root_view_id", it.root_view_id, json.string),
    codec.optional("app_id", it.app_id, json.string),
    codec.optional("bot_id", it.bot_id, json.string),
    codec.optional(
      "app_installed_team_id",
      it.app_installed_team_id,
      json.string,
    ),
