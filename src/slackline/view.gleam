  use v_id <- codec.optional_field("id", decode.string)
  use v_team_id <- codec.optional_field("team_id", decode.string)
  use v_state <- codec.optional_field(
    "state",
    decode.recursive(view_state_decoder),
  )
  use v_hash <- codec.optional_field("hash", decode.string)
