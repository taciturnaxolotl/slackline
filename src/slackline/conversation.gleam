/// The kind of a channel tab.
pub type ConversationTabType {
  /// `list`
  ListTab
  /// `canvas`
  Canvas
  /// `files`
  Files
  /// `bookmarks`
  Bookmarks
  /// `folder`
  Folder
  /// `pins`
  Pins
  /// `workflows`
  Workflows
  /// `channel_canvas`
  ChannelCanvas
  /// `record_list`
  RecordList
  /// `record_overview`
  RecordOverview
  /// `record_summary`
  RecordSummary
  /// `record_related_list`
  RecordRelatedList
  /// `salesforce_list_view`
  SalesforceListView
  /// A value that this version of slackline does not know.
  UnknownConversationTabType(String)
}

/// The json string of `ConversationTabType`.
pub fn conversation_tab_type_to_string(it: ConversationTabType) -> String {
  case it {
    ListTab -> "list"
    Canvas -> "canvas"
    Files -> "files"
    Bookmarks -> "bookmarks"
    Folder -> "folder"
    Pins -> "pins"
    Workflows -> "workflows"
    ChannelCanvas -> "channel_canvas"
    RecordList -> "record_list"
    RecordOverview -> "record_overview"
    RecordSummary -> "record_summary"
    RecordRelatedList -> "record_related_list"
    SalesforceListView -> "salesforce_list_view"
    UnknownConversationTabType(other) -> other
  }
}

/// Parses `ConversationTabType` from its json string.
pub fn conversation_tab_type_from_string(
  string: String,
) -> ConversationTabType {
  case string {
    "list" -> ListTab
    "canvas" -> Canvas
    "files" -> Files
    "bookmarks" -> Bookmarks
    "folder" -> Folder
    "pins" -> Pins
    "workflows" -> Workflows
    "channel_canvas" -> ChannelCanvas
    "record_list" -> RecordList
    "record_overview" -> RecordOverview
    "record_summary" -> RecordSummary
    "record_related_list" -> RecordRelatedList
    "salesforce_list_view" -> SalesforceListView
    other -> UnknownConversationTabType(other)
  }
}

/// Decodes `ConversationTabType` from a json string.
pub fn conversation_tab_type_decoder() -> decode.Decoder(ConversationTabType) {
  decode.map(decode.string, conversation_tab_type_from_string)
}

/// Encodes `ConversationTabType` as a json string.
pub fn conversation_tab_type_to_json(it: ConversationTabType) -> json.Json {
  json.string(conversation_tab_type_to_string(it))
}
