/// A user's huddle status.
pub type HuddleState {
  /// `default_unset`
  DefaultUnset
  /// `in_a_huddle`
  InAHuddle
  /// `available_for_huddle`
  AvailableForHuddle
  /// A value that this version of slackline does not know.
  UnknownHuddleState(String)
}

/// The json string of `HuddleState`.
pub fn huddle_state_to_string(it: HuddleState) -> String {
  case it {
    DefaultUnset -> "default_unset"
    InAHuddle -> "in_a_huddle"
    AvailableForHuddle -> "available_for_huddle"
    UnknownHuddleState(other) -> other
  }
}

/// Parses `HuddleState` from its json string.
pub fn huddle_state_from_string(string: String) -> HuddleState {
  case string {
    "default_unset" -> DefaultUnset
    "in_a_huddle" -> InAHuddle
    "available_for_huddle" -> AvailableForHuddle
    other -> UnknownHuddleState(other)
  }
}

/// Decodes `HuddleState` from a json string.
pub fn huddle_state_decoder() -> decode.Decoder(HuddleState) {
  decode.map(decode.string, huddle_state_from_string)
}

/// Encodes `HuddleState` as a json string.
pub fn huddle_state_to_json(it: HuddleState) -> json.Json {
  json.string(huddle_state_to_string(it))
}
