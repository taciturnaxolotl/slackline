/// How a file is stored.
pub type FileMode {
  /// `hosted`
  Hosted
  /// `external`
  External
  /// `snippet`
  Snippet
  /// `post`
  Post
  /// Slack Connect file whose details must be fetched with `files.info`.
  FileAccess
  /// `hidden_by_limit`
  HiddenByLimit
  /// `list`
  ListFile
  /// A canvas.
  Quip
  /// An email forwarded into Slack.
  Email
  /// A deleted file that still has a placeholder in a conversation.
  Tombstone
  /// A value that this version of slackline does not know.
  UnknownFileMode(String)
}

/// The json string of `FileMode`.
pub fn file_mode_to_string(it: FileMode) -> String {
  case it {
    Hosted -> "hosted"
    External -> "external"
    Snippet -> "snippet"
    Post -> "post"
    FileAccess -> "file_access"
    HiddenByLimit -> "hidden_by_limit"
    ListFile -> "list"
    Quip -> "quip"
    Email -> "email"
    Tombstone -> "tombstone"
    UnknownFileMode(other) -> other
  }
}

/// Parses `FileMode` from its json string.
pub fn file_mode_from_string(string: String) -> FileMode {
  case string {
    "hosted" -> Hosted
    "external" -> External
    "snippet" -> Snippet
    "post" -> Post
    "file_access" -> FileAccess
    "hidden_by_limit" -> HiddenByLimit
    "list" -> ListFile
    "quip" -> Quip
    "email" -> Email
    "tombstone" -> Tombstone
    other -> UnknownFileMode(other)
  }
}

/// Decodes `FileMode` from a json string.
pub fn file_mode_decoder() -> decode.Decoder(FileMode) {
  decode.map(decode.string, file_mode_from_string)
}

/// Encodes `FileMode` as a json string.
pub fn file_mode_to_json(it: FileMode) -> json.Json {
  json.string(file_mode_to_string(it))
}

