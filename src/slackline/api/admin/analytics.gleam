  }
}

/// Parses `AnalyticsFileType` from its json string.
pub fn analytics_file_type_from_string(
  string: String,
) -> Result(AnalyticsFileType, Nil) {
  case string {
    "member" -> Ok(Member)
    "public_channel" -> Ok(PublicChannel)
    _ -> Error(Nil)
  }
}

/// Decodes `AnalyticsFileType` from a json string.
pub fn analytics_file_type_decoder() -> decode.Decoder(AnalyticsFileType) {
  use string <- decode.then(decode.string)
  case analytics_file_type_from_string(string) {
    Ok(parsed) -> decode.success(parsed)
    Error(Nil) -> decode.failure(Member, "AnalyticsFileType")
  }
}

/// Encodes `AnalyticsFileType` as a json string.
pub fn analytics_file_type_to_json(it: AnalyticsFileType) -> json.Json {
  json.string(analytics_file_type_to_string(it))
}

