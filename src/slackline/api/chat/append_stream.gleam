/// Accepts message text formatted in markdown. Limit this field to 12,000
/// characters. This text is what will be appended to the message received so
/// far.
pub fn markdown_text(
  call: slackline.Call(chat.AppendStream, r),
  markdown_text: String,
) -> slackline.Call(chat.AppendStream, r) {
  slackline.with_param(call, "markdown_text", markdown_text)
}
