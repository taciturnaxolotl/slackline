      )
    "file_input" ->
      decode.map(decode.recursive(file_input_element_decoder), FileInput)
    "image" ->
      decode.map(decode.recursive(image_element_decoder), ImageAccessory)
    "static_select" ->
      decode.map(decode.recursive(static_select_element_decoder), StaticSelect)
    "external_select" ->
      decode.map(
        decode.recursive(external_select_element_decoder),
        ExternalSelect,
      )
    "users_select" ->
      decode.map(decode.recursive(users_select_element_decoder), UsersSelect)
    "conversations_select" ->
      decode.map(
        decode.recursive(conversations_select_element_decoder),
        ConversationsSelect,
      )
    "channels_select" ->
      decode.map(
        decode.recursive(channels_select_element_decoder),
        ChannelsSelect,
      )
    "multi_static_select" ->
      decode.map(
        decode.recursive(multi_static_select_element_decoder),
        MultiStaticSelect,
      )
    "multi_external_select" ->
      decode.map(
        decode.recursive(multi_external_select_element_decoder),
        MultiExternalSelect,
      )
    "multi_users_select" ->
      decode.map(
        decode.recursive(multi_users_select_element_decoder),
        MultiUsersSelect,
      )
    "multi_conversations_select" ->
      decode.map(
        decode.recursive(multi_conversations_select_element_decoder),
        MultiConversationsSelect,
      )
    "multi_channels_select" ->
      decode.map(
        decode.recursive(multi_channels_select_element_decoder),
        MultiChannelsSelect,
      )
    "number_input" ->
      decode.map(decode.recursive(number_input_element_decoder), NumberInput)
    "overflow" ->
      decode.map(decode.recursive(overflow_element_decoder), Overflow)
    "plain_text_input" ->
      decode.map(
        decode.recursive(plain_text_input_element_decoder),
        PlainTextInput,
      )
    "radio_buttons" ->
      decode.map(decode.recursive(radio_buttons_element_decoder), RadioButtons)
    "rich_text_input" ->
