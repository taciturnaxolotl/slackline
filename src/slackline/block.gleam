/// The interactive block elements.
///
/// Where each variant is allowed:
/// - section `accessory`: button, checkboxes, datepicker, image, all
///   selects and multi-selects, overflow, radio_buttons, timepicker,
///   workflow_button
/// - actions `elements`: button, checkboxes, datepicker, datetimepicker,
///   all selects and multi-selects, overflow, radio_buttons, timepicker,
///   workflow_button
/// - input `element`: checkboxes, datepicker, datetimepicker,
///   email_text_input, file_input, all selects and multi-selects,
///   number_input, plain_text_input, radio_buttons, rich_text_input,
///   timepicker, url_text_input
pub type Element {
  Button(ButtonElement)
  Checkboxes(CheckboxesElement)
  Datepicker(DatepickerElement)
  Datetimepicker(DatetimepickerElement)
  EmailTextInput(EmailTextInputElement)
  FileInput(FileInputElement)
  /// An image. Only allowed as a section accessory (and in card and
  /// container icons). Context blocks use `ContextElement`. Set `image_url`
  /// or `slack_file`.
  ImageAccessory(ImageElement)
  /// A select menu with a static list of options. Set `options` or
  /// `option_groups`.
  /// https://docs.slack.dev/reference/block-kit/block-elements/select-menu-element
  StaticSelect(StaticSelectElement)
  ExternalSelect(ExternalSelectElement)
  UsersSelect(UsersSelectElement)
  ConversationsSelect(ConversationsSelectElement)
  ChannelsSelect(ChannelsSelectElement)
  /// A multi-select menu with a static list of options. Set `options` or
  /// `option_groups`.
  /// https://docs.slack.dev/reference/block-kit/block-elements/multi-select-menu-element
  MultiStaticSelect(MultiStaticSelectElement)
  MultiExternalSelect(MultiExternalSelectElement)
  MultiUsersSelect(MultiUsersSelectElement)
  MultiConversationsSelect(MultiConversationsSelectElement)
  MultiChannelsSelect(MultiChannelsSelectElement)
  NumberInput(NumberInputElement)
  Overflow(OverflowElement)
  PlainTextInput(PlainTextInputElement)
  RadioButtons(RadioButtonsElement)
  RichTextInput(RichTextInputElement)
  Timepicker(TimepickerElement)
  UrlTextInput(UrlTextInputElement)
  WorkflowButton(WorkflowButtonElement)
  /// A `type` that this version of slackline does not know. `raw` holds the
  /// full json.
  UnknownElement(type_: String, raw: value.Value)
}

/// Decodes `Element` from json. The `type` field selects the variant.
pub fn element_decoder() -> decode.Decoder(Element) {
  use tag <- decode.optional_field("type", "", decode.string)
  case tag {
    "button" -> decode.map(decode.recursive(button_element_decoder), Button)
    "checkboxes" ->
      decode.map(decode.recursive(checkboxes_element_decoder), Checkboxes)
    "datepicker" ->
      decode.map(decode.recursive(datepicker_element_decoder), Datepicker)
