/// A Block Kit block.
/// https://docs.slack.dev/reference/block-kit/blocks
pub type Block {
  Actions(ActionsBlock)
  Alert(AlertBlock)
  Card(CardBlock)
  Carousel(CarouselBlock)
  Container(ContainerBlock)
  Context(ContextBlock)
  ContextActions(ContextActionsBlock)
  DataTable(DataTableBlock)
  DataVisualization(DataVisualizationBlock)
  Divider(DividerBlock)
  File(FileBlock)
  Header(HeaderBlock)
  /// An image. Set `image_url` or `slack_file`.
  /// https://docs.slack.dev/reference/block-kit/blocks/image-block
  Image(ImageBlock)
  Input(InputBlock)
  Layout(LayoutBlock)
  Markdown(MarkdownBlock)
  Plan(PlanBlock)
  /// Formatted, structured text.
  RichTextBlock(RichText)
  Section(SectionBlock)
  Table(TableBlock)
  TaskCard(TaskCardBlock)
  Video(VideoBlock)
  /// A `type` that this version of slackline does not know. `raw` holds the
  /// full json.
  UnknownBlock(type_: String, raw: value.Value)
}

/// Decodes `Block` from json. The `type` field selects the variant.
pub fn block_decoder() -> decode.Decoder(Block) {
  use tag <- decode.optional_field("type", "", decode.string)
  case tag {
    "actions" -> decode.map(decode.recursive(actions_block_decoder), Actions)
    "alert" -> decode.map(decode.recursive(alert_block_decoder), Alert)
    "card" -> decode.map(decode.recursive(card_block_decoder), Card)
    "carousel" -> decode.map(decode.recursive(carousel_block_decoder), Carousel)
    "container" ->
      decode.map(decode.recursive(container_block_decoder), Container)
    "context" -> decode.map(decode.recursive(context_block_decoder), Context)
    "context_actions" ->
      decode.map(
        decode.recursive(context_actions_block_decoder),
        ContextActions,
      )
    "data_table" ->
      decode.map(decode.recursive(data_table_block_decoder), DataTable)
    "data_visualization" ->
      decode.map(
        decode.recursive(data_visualization_block_decoder),
        DataVisualization,
      )
    "divider" -> decode.map(decode.recursive(divider_block_decoder), Divider)
    "file" -> decode.map(decode.recursive(file_block_decoder), File)
    "header" -> decode.map(decode.recursive(header_block_decoder), Header)
    "image" -> decode.map(decode.recursive(image_block_decoder), Image)
    "input" -> decode.map(decode.recursive(input_block_decoder), Input)
    "layout" -> decode.map(decode.recursive(layout_block_decoder), Layout)
    "markdown" -> decode.map(decode.recursive(markdown_block_decoder), Markdown)
    "plan" -> decode.map(decode.recursive(plan_block_decoder), Plan)
    "rich_text" ->
      decode.map(decode.recursive(rich_text_decoder), RichTextBlock)
    "section" -> decode.map(decode.recursive(section_block_decoder), Section)
    "table" -> decode.map(decode.recursive(table_block_decoder), Table)
    "task_card" ->
      decode.map(decode.recursive(task_card_block_decoder), TaskCard)
    "video" -> decode.map(decode.recursive(video_block_decoder), Video)
    _ -> decode.map(value.decoder(), UnknownBlock(type_: tag, raw: _))
  }
}

/// Encodes `Block` as json.
pub fn block_to_json(it: Block) -> json.Json {
  case it {
    Actions(inner) -> actions_block_to_json(inner)
    Alert(inner) -> alert_block_to_json(inner)
    Card(inner) -> card_block_to_json(inner)
    Carousel(inner) -> carousel_block_to_json(inner)
    Container(inner) -> container_block_to_json(inner)
    Context(inner) -> context_block_to_json(inner)
    ContextActions(inner) -> context_actions_block_to_json(inner)
    DataTable(inner) -> data_table_block_to_json(inner)
    DataVisualization(inner) -> data_visualization_block_to_json(inner)
    Divider(inner) -> divider_block_to_json(inner)
    File(inner) -> file_block_to_json(inner)
    Header(inner) -> header_block_to_json(inner)
    Image(inner) -> image_block_to_json(inner)
    Input(inner) -> input_block_to_json(inner)
    Layout(inner) -> layout_block_to_json(inner)
    Markdown(inner) -> markdown_block_to_json(inner)
    Plan(inner) -> plan_block_to_json(inner)
    RichTextBlock(inner) -> rich_text_to_json(inner)
    Section(inner) -> section_block_to_json(inner)
    Table(inner) -> table_block_to_json(inner)
    TaskCard(inner) -> task_card_block_to_json(inner)
    Video(inner) -> video_block_to_json(inner)
    UnknownBlock(raw:, ..) -> value.to_json(raw)
  }
}

/// An optional field for a builder. `record` is the record the builder
/// makes, so each builder only takes its own attributes.
pub opaque type Attr(record) {
  Attr(fn(record) -> record)
}

/// An attribute that updates the record with `set`. The attribute
/// modules use it, and you can use it for a change that they do not cover.
pub fn attr(set: fn(record) -> record) -> Attr(record) {
  Attr(set)
}

@internal
pub fn apply(record: record, attrs: List(Attr(record))) -> record {
  list.fold(attrs, record, fn(record, attr) {
    let Attr(set) = attr
    set(record)
  })
}

