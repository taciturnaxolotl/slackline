/// Rich text list styles.
pub type RichTextListStyle {
  /// `bullet`
  Bullet
  /// A numbered list.
  Ordered
  /// A value that this version of slackline does not know.
  UnknownRichTextListStyle(String)
}

/// The json string of `RichTextListStyle`.
pub fn rich_text_list_style_to_string(it: RichTextListStyle) -> String {
  case it {
    Bullet -> "bullet"
    Ordered -> "ordered"
    UnknownRichTextListStyle(other) -> other
  }
}

/// Parses `RichTextListStyle` from its json string.
pub fn rich_text_list_style_from_string(string: String) -> RichTextListStyle {
  case string {
    "bullet" -> Bullet
    "ordered" -> Ordered
    other -> UnknownRichTextListStyle(other)
  }
}

/// Decodes `RichTextListStyle` from a json string.
pub fn rich_text_list_style_decoder() -> decode.Decoder(RichTextListStyle) {
  decode.map(decode.string, rich_text_list_style_from_string)
}

/// Encodes `RichTextListStyle` as a json string.
pub fn rich_text_list_style_to_json(it: RichTextListStyle) -> json.Json {
  json.string(rich_text_list_style_to_string(it))
}

/// The top-level children of a rich text block.
pub type RichTextObject {
  /// A paragraph of inline elements.
  RichTextSection(elements: List(RichTextElement))
  /// A bulleted or numbered list. Each item is a `rich_text_section`.
  RichTextList(
    /// `bullet` or `ordered`.
    style: Option(RichTextListStyle),
    elements: List(RichTextObject),
    /// Sub-list indent level.
    indent: Option(Int),
    /// Number to offset the first number of an ordered list by.
    offset: Option(Int),
    /// Border on (1) or off (0).
    border: Option(Int),
  )
