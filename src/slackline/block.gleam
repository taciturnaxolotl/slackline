  /// full json.
  UnknownTableCell(type_: String, raw: value.Value)
}

/// Decodes `TableCell` from json. The `type` field selects the variant.
pub fn table_cell_decoder() -> decode.Decoder(TableCell) {
  use tag <- decode.optional_field("type", "", decode.string)
  case tag {
    "raw_text" -> {
      use v_text <- decode.field("text", decode.string)
      decode.success(RawTextCell(text: v_text))
    }
    "raw_number" -> {
      use v_value <- codec.optional_field("value", codec.float_decoder())
      use v_text <- codec.optional_field("text", decode.string)
      decode.success(RawNumberCell(value: v_value, text: v_text))
    }
    "rich_text" -> decode.map(decode.recursive(rich_text_decoder), RichTextCell)
    "action_cell" -> {
      use v_element <- decode.field(
        "element",
        decode.recursive(element_decoder),
      )
      use v_fallback <- codec.optional_field(
        "fallback",
        decode.recursive(table_cell_decoder),
      )
      decode.success(ActionCell(element: v_element, fallback: v_fallback))
    }
    _ -> decode.map(value.decoder(), UnknownTableCell(type_: tag, raw: _))
  }
}

/// Encodes `TableCell` as json.
pub fn table_cell_to_json(it: TableCell) -> json.Json {
  case it {
    RawTextCell(text: v_text) ->
      codec.object([
        codec.field("type", json.string("raw_text")),
        codec.field("text", json.string(v_text)),
      ])
    RawNumberCell(value: v_value, text: v_text) ->
      codec.object([
        codec.field("type", json.string("raw_number")),
        codec.optional("value", v_value, json.float),
        codec.optional("text", v_text, json.string),
      ])
    RichTextCell(inner) -> rich_text_to_json(inner)
    ActionCell(element: v_element, fallback: v_fallback) ->
      codec.object([
        codec.field("type", json.string("action_cell")),
        codec.field("element", element_to_json(v_element)),
        codec.optional("fallback", v_fallback, table_cell_to_json),
      ])
    UnknownTableCell(raw:, ..) -> value.to_json(raw)
  }
}

