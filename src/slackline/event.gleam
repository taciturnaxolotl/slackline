      use v_event_ts <- codec.optional_field("event_ts", decode.string)
      decode.success(TeamRename(
        name: v_name,
        team_id: v_team_id,
        event_ts: v_event_ts,
      ))
    }
    "tokens_revoked" -> {
      use v_tokens <- decode.field(
        "tokens",
        decode.recursive(revoked_tokens_decoder),
      )
      use v_event_ts <- codec.optional_field("event_ts", decode.string)
      decode.success(TokensRevoked(tokens: v_tokens, event_ts: v_event_ts))
    }
    "user_change" -> {
      use v_user <- decode.field("user", user.user_decoder())
      use v_cache_ts <- codec.optional_field("cache_ts", decode.int)
      use v_event_ts <- codec.optional_field("event_ts", decode.string)
      decode.success(UserChange(
        user: v_user,
        cache_ts: v_cache_ts,
        event_ts: v_event_ts,
      ))
    }
    "user_connection" -> {
      use v_subtype <- codec.optional_field(
        "subtype",
        user_connection_subtype_decoder(),
      )
      use v_user <- decode.field("user", decode.string)
      use v_enterprise_id <- codec.optional_field(
        "enterprise_id",
        decode.string,
      )
      use v_trigger_id <- codec.optional_field("trigger_id", decode.string)
      use v_event_ts <- codec.optional_field("event_ts", decode.string)
      decode.success(UserConnection(
        subtype: v_subtype,
        user: v_user,
        enterprise_id: v_enterprise_id,
        trigger_id: v_trigger_id,
        event_ts: v_event_ts,
