/// A brief reference to what was reacted to.
pub type ReactionItem {
  ReactionItemMessage(
    channel: String,
    ts: String,
    channel_type: Option(MessageChannelType),
  )
  ReactionItemFile(file: String)
  ReactionItemFileComment(file_comment: String, file: Option(String))
  /// A `type` that this version of slackline does not know. `raw` holds the
  /// full json.
  UnknownReactionItem(type_: String, raw: value.Value)
}

/// Decodes `ReactionItem` from json. The `type` field selects the variant.
pub fn reaction_item_decoder() -> decode.Decoder(ReactionItem) {
  use tag <- decode.optional_field("type", "", decode.string)
  case tag {
    "message" -> {
      use v_channel <- decode.field("channel", decode.string)
      use v_ts <- decode.field("ts", decode.string)
      use v_channel_type <- codec.optional_field(
        "channel_type",
        message_channel_type_decoder(),
      )
      decode.success(ReactionItemMessage(
        channel: v_channel,
        ts: v_ts,
        channel_type: v_channel_type,
      ))
    }
    "file" -> {
      use v_file <- decode.field("file", decode.string)
      decode.success(ReactionItemFile(file: v_file))
    }
    "file_comment" -> {
      use v_file_comment <- decode.field("file_comment", decode.string)
      use v_file <- codec.optional_field("file", decode.string)
      decode.success(ReactionItemFileComment(
        file_comment: v_file_comment,
        file: v_file,
      ))
    }
    _ -> decode.map(value.decoder(), UnknownReactionItem(type_: tag, raw: _))
  }
}

/// Encodes `ReactionItem` as json.
pub fn reaction_item_to_json(it: ReactionItem) -> json.Json {
  case it {
    ReactionItemMessage(
      channel: v_channel,
      ts: v_ts,
      channel_type: v_channel_type,
    ) ->
      codec.object([
        codec.field("type", json.string("message")),
        codec.field("channel", json.string(v_channel)),
        codec.field("ts", json.string(v_ts)),
        codec.optional(
          "channel_type",
          v_channel_type,
          message_channel_type_to_json,
        ),
      ])
    ReactionItemFile(file: v_file) ->
      codec.object([
        codec.field("type", json.string("file")),
        codec.field("file", json.string(v_file)),
      ])
    ReactionItemFileComment(file_comment: v_file_comment, file: v_file) ->
      codec.object([
        codec.field("type", json.string("file_comment")),
        codec.field("file_comment", json.string(v_file_comment)),
        codec.optional("file", v_file, json.string),
      ])
    UnknownReactionItem(raw:, ..) -> value.to_json(raw)
  }
}

