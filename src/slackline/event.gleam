      use v_event_ts <- codec.optional_field("event_ts", decode.string)
      decode.success(TeamDomainChange(
        url: v_url,
        domain: v_domain,
        team_id: v_team_id,
        event_ts: v_event_ts,
      ))
    }
    "team_join" -> {
      use v_user <- decode.field("user", user.user_decoder())
      use v_event_ts <- codec.optional_field("event_ts", decode.string)
      decode.success(TeamJoin(user: v_user, event_ts: v_event_ts))
