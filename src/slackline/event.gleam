        channel_type: v_channel_type,
        event_ts: v_event_ts,
      ))
    }
    "thread_broadcast" -> {
      use _ <- decode.optional_field(
        "type",
        "message",
        codec.constant("message"),
      )
      use v_channel <- codec.optional_field("channel", decode.string)
      use v_user <- codec.optional_field("user", decode.string)
      use v_text <- codec.optional_field("text", decode.string)
      use v_ts <- decode.field("ts", decode.string)
      use v_thread_ts <- codec.optional_field("thread_ts", decode.string)
      use v_root <- codec.optional_field("root", message.message_decoder())
      use v_blocks <- codec.optional_field(
        "blocks",
        decode.list(block.block_decoder()),
      )
      use v_client_msg_id <- codec.optional_field(
        "client_msg_id",
        decode.string,
      )
      use v_channel_type <- codec.optional_field(
        "channel_type",
        message_channel_type_decoder(),
      )
      use v_event_ts <- codec.optional_field("event_ts", decode.string)
      decode.success(ThreadBroadcast(
        channel: v_channel,
        user: v_user,
        text: v_text,
        ts: v_ts,
        thread_ts: v_thread_ts,
        root: v_root,
        blocks: v_blocks,
        client_msg_id: v_client_msg_id,
        channel_type: v_channel_type,
        event_ts: v_event_ts,
      ))
    }
    "unpinned_item" -> {
      use _ <- decode.optional_field(
        "type",
        "message",
        codec.constant("message"),
      )
      use v_channel <- decode.field("channel", decode.string)
      use v_user <- codec.optional_field("user", decode.string)
      use v_text <- codec.optional_field("text", decode.string)
      use v_ts <- decode.field("ts", decode.string)
      use v_item_type <- codec.optional_field(
        "item_type",
        pinned_message_item_type_decoder(),
      )
      use v_item <- codec.optional_field(
        "item",
        decode.recursive(event_pin_item_decoder),
      )
      use v_channel_type <- codec.optional_field(
        "channel_type",
        message_channel_type_decoder(),
      )
      use v_event_ts <- codec.optional_field("event_ts", decode.string)
      decode.success(UnpinnedItemMessage(
        channel: v_channel,
        user: v_user,
        text: v_text,
        ts: v_ts,
        item_type: v_item_type,
        item: v_item,
        channel_type: v_channel_type,
        event_ts: v_event_ts,
      ))
    }
    _ -> decode.map(value.decoder(), UnknownMessageEvent(subtype: tag, raw: _))
  }
}

