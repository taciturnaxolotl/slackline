      ])
    TeamDomainChange(
      url: v_url,
      domain: v_domain,
      team_id: v_team_id,
      event_ts: v_event_ts,
    ) ->
      codec.object([
        codec.field("type", json.string("team_domain_change")),
        codec.optional("url", v_url, json.string),
        codec.optional("domain", v_domain, json.string),
        codec.optional("team_id", v_team_id, json.string),
        codec.optional("event_ts", v_event_ts, json.string),
      ])
    TeamJoin(user: v_user, event_ts: v_event_ts) ->
      codec.object([
        codec.field("type", json.string("team_join")),
        codec.field("user", user.user_to_json(v_user)),
        codec.optional("event_ts", v_event_ts, json.string),
      ])
    TeamRename(name: v_name, team_id: v_team_id, event_ts: v_event_ts) ->
      codec.object([
        codec.field("type", json.string("team_rename")),
        codec.optional("name", v_name, json.string),
        codec.optional("team_id", v_team_id, json.string),
        codec.optional("event_ts", v_event_ts, json.string),
      ])
    TokensRevoked(tokens: v_tokens, event_ts: v_event_ts) ->
      codec.object([
        codec.field("type", json.string("tokens_revoked")),
        codec.field("tokens", revoked_tokens_to_json(v_tokens)),
        codec.optional("event_ts", v_event_ts, json.string),
      ])
    UserChange(user: v_user, cache_ts: v_cache_ts, event_ts: v_event_ts) ->
      codec.object([
        codec.field("type", json.string("user_change")),
        codec.field("user", user.user_to_json(v_user)),
        codec.optional("cache_ts", v_cache_ts, json.int),
        codec.optional("event_ts", v_event_ts, json.string),
      ])
    UserConnection(
      subtype: v_subtype,
      user: v_user,
      enterprise_id: v_enterprise_id,
      trigger_id: v_trigger_id,
      event_ts: v_event_ts,
    ) ->
      codec.object([
        codec.field("type", json.string("user_connection")),
        codec.optional("subtype", v_subtype, user_connection_subtype_to_json),
        codec.field("user", json.string(v_user)),
        codec.optional("enterprise_id", v_enterprise_id, json.string),
        codec.optional("trigger_id", v_trigger_id, json.string),
        codec.optional("event_ts", v_event_ts, json.string),
      ])
    UserGuestStatusChanged(
      user: v_user,
      cache_ts: v_cache_ts,
      event_ts: v_event_ts,
    ) ->
      codec.object([
        codec.field("type", json.string("user_guest_status_changed")),
        codec.field("user", user.user_to_json(v_user)),
        codec.optional("cache_ts", v_cache_ts, json.int),
        codec.optional("event_ts", v_event_ts, json.string),
      ])
    UserHuddleChanged(user: v_user, cache_ts: v_cache_ts, event_ts: v_event_ts) ->
      codec.object([
        codec.field("type", json.string("user_huddle_changed")),
        codec.field("user", user.user_to_json(v_user)),
        codec.optional("cache_ts", v_cache_ts, json.int),
        codec.optional("event_ts", v_event_ts, json.string),
      ])
    UserProfileChanged(user: v_user, cache_ts: v_cache_ts, event_ts: v_event_ts) ->
      codec.object([
        codec.field("type", json.string("user_profile_changed")),
        codec.field("user", user.user_to_json(v_user)),
        codec.optional("cache_ts", v_cache_ts, json.int),
        codec.optional("event_ts", v_event_ts, json.string),
      ])
    UserStatusChanged(user: v_user, cache_ts: v_cache_ts, event_ts: v_event_ts) ->
      codec.object([
        codec.field("type", json.string("user_status_changed")),
        codec.field("user", user.user_to_json(v_user)),
        codec.optional("cache_ts", v_cache_ts, json.int),
        codec.optional("event_ts", v_event_ts, json.string),
      ])
    UnknownEvent(raw:, ..) -> value.to_json(raw)
  }
}

/// A `message` event, dispatching on `subtype`. Plain messages have no
/// subtype. `message_replied` events arrive without a subtype over the Events
/// API, so check `thread_ts` on plain messages too.
pub type MessageEvent {
  /// A plain message, possibly with files, blocks or attachments.
  PlainMessage(
    channel: String,
    user: Option(String),
    text: Option(String),
    ts: Option(String),
    thread_ts: Option(String),
    channel_type: Option(MessageChannelType),
    team: Option(String),
    blocks: Option(List(block.Block)),
    attachments: Option(List(attachment.Attachment)),
    files: Option(List(file.File)),
    /// Whether the share happened at upload time.
    upload: Option(Bool),
    display_as_bot: Option(Bool),
    edited: Option(message.MessageEdited),
    client_msg_id: Option(String),
    bot_id: Option(String),
    bot_profile: Option(message.BotProfile),
    app_id: Option(String),
    parent_user_id: Option(String),
    metadata: Option(message.MessageMetadata),
    reactions: Option(List(common.Reaction)),
    is_starred: Option(Bool),
    pinned_to: Option(List(String)),
    /// Sent when the app is subscribed to `app_context_changed`.
    app_context: Option(AppContext),
    /// Present when Slack omits the `message_replied` subtype.
    message: Option(message.Message),
    hidden: Option(Bool),
    event_ts: Option(String),
  )
  /// The root message of an assistant thread.
  AssistantAppThreadMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: Option(String),
    thread_ts: Option(String),
    channel_type: Option(MessageChannelType),
    team: Option(String),
    blocks: Option(List(block.Block)),
    assistant_app_thread: Option(message.AssistantAppThreadInfo),
    event_ts: Option(String),
  )
  /// A message was posted by an integration.
  BotMessage(
    channel: Option(String),
    text: Option(String),
    ts: String,
    thread_ts: Option(String),
    channel_type: Option(MessageChannelType),
    bot_id: Option(String),
    bot_profile: Option(message.BotProfile),
    /// Overrides the bot's default username.
    username: Option(String),
    /// Overrides the bot's default icons.
    icons: Option(dict.Dict(String, String)),
    blocks: Option(List(block.Block)),
    attachments: Option(List(attachment.Attachment)),
    app_id: Option(String),
    event_ts: Option(String),
  )
  /// A channel was archived.
  ChannelArchiveMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A channel was made private.
  ChannelConvertToPrivateMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A channel was made public.
  ChannelConvertToPublicMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A member joined a channel.
  ChannelJoinMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    /// The inviting user, absent if the user was not invited.
    inviter: Option(String),
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A member left a channel.
  ChannelLeaveMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A channel was renamed.
  ChannelNameMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    old_name: Option(String),
    name: Option(String),
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// The posting permissions for a channel changed.
  ChannelPostingPermissionsMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A channel purpose was updated.
  ChannelPurposeMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    purpose: Option(String),
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A channel topic was updated.
  ChannelTopicMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    topic: Option(String),
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A channel was unarchived.
  ChannelUnarchiveMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A bot was mentioned in the body of a canvas.
  DocumentMentionMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    team: Option(String),
    blocks: Option(List(block.Block)),
    document_mention: Option(DocumentMention),
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// Message content redacted due to Enterprise Key Management. The author is
  /// `UREVOKEDU`.
  EkmAccessDeniedMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A comment was added to a file (no longer served).
  FileCommentMessage(
    channel: Option(String),
    text: Option(String),
    ts: String,
    file: Option(file.File),
    /// The file comment object.
    comment: Option(value.Value),
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A file was mentioned in a channel (no longer served).
  FileMentionMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    file: Option(file.File),
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A file was shared into a channel. In the Events API, a shared file can
  /// also arrive without a subtype. See `PlainMessage.files`.
  FileShareMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    files: Option(List(file.File)),
    upload: Option(Bool),
    display_as_bot: Option(Bool),
    bot_id: Option(String),
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A private group was archived.
  GroupArchiveMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    members: Option(List(String)),
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A member joined a private group.
  GroupJoinMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    inviter: Option(String),
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A member left a private group.
  GroupLeaveMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A private group was renamed.
  GroupNameMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    old_name: Option(String),
    name: Option(String),
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A private group purpose was updated.
  GroupPurposeMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    purpose: Option(String),
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A private group topic was updated.
  GroupTopicMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    topic: Option(String),
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A private group was unarchived.
  GroupUnarchiveMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A `/me` message was sent.
  MeMessage(
    channel: String,
    user: Option(String),
    text: Option(String),
    ts: String,
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A message was changed. Replace the message with the same `message.ts`.
  MessageChanged(
    channel: String,
    hidden: Option(Bool),
    ts: String,
    /// The updated message.
    message: message.Message,
    /// The message before the change.
    previous_message: Option(message.Message),
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A message was deleted.
  MessageDeleted(
    channel: String,
    hidden: Option(Bool),
    ts: String,
    /// The timestamp of the deleted message.
    deleted_ts: String,
    previous_message: Option(message.Message),
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A message thread received a reply. Over the Events API this usually
  /// arrives without a subtype, as a `PlainMessage`.
  MessageReplied(
    channel: String,
    hidden: Option(Bool),
    ts: String,
    /// The parent message.
    message: message.Message,
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// An item was pinned in a channel.
  PinnedItemMessage(
    channel: String,
    user: Option(String),
    text: Option(String),
    ts: String,
    item_type: Option(PinnedMessageItemType),
    item: Option(EventPinItem),
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A reminder was added to the channel.
  ReminderAddMessage(
    channel: Option(String),
    user: Option(String),
    team: Option(String),
    text: Option(String),
    ts: String,
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A thread reply was broadcast to the channel (no longer served, see
  /// `thread_broadcast`).
  ReplyBroadcastMessage(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    thread_ts: Option(String),
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A thread reply was broadcast to the channel.
  ThreadBroadcast(
    channel: Option(String),
    user: Option(String),
    text: Option(String),
    ts: String,
    thread_ts: Option(String),
    /// A modified form of the thread's original message.
    root: Option(message.Message),
    blocks: Option(List(block.Block)),
    client_msg_id: Option(String),
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// An item was unpinned from a channel.
  UnpinnedItemMessage(
    channel: String,
    user: Option(String),
    text: Option(String),
    ts: String,
    item_type: Option(PinnedMessageItemType),
    item: Option(EventPinItem),
    channel_type: Option(MessageChannelType),
    event_ts: Option(String),
  )
  /// A `subtype` that this version of slackline does not know. `raw` holds the
  /// full json.
  UnknownMessageEvent(subtype: String, raw: value.Value)
}

/// Decodes `MessageEvent` from json. The `subtype` field selects the variant.
pub fn message_event_decoder() -> decode.Decoder(MessageEvent) {
  use tag <- decode.optional_field("subtype", "", decode.string)
  case tag {
    "" -> {
      use _ <- decode.optional_field(
        "type",
        "message",
        codec.constant("message"),
      )
      use v_channel <- decode.field("channel", decode.string)
      use v_user <- codec.optional_field("user", decode.string)
      use v_text <- codec.optional_field("text", decode.string)
      use v_ts <- codec.optional_field("ts", decode.string)
      use v_thread_ts <- codec.optional_field("thread_ts", decode.string)
      use v_channel_type <- codec.optional_field(
        "channel_type",
        message_channel_type_decoder(),
      )
      use v_team <- codec.optional_field("team", decode.string)
      use v_blocks <- codec.optional_field(
        "blocks",
        decode.list(block.block_decoder()),
      )
      use v_attachments <- codec.optional_field(
        "attachments",
        decode.list(attachment.attachment_decoder()),
      )
      use v_files <- codec.optional_field(
        "files",
        decode.list(file.file_decoder()),
      )
      use v_upload <- codec.optional_field("upload", decode.bool)
      use v_display_as_bot <- codec.optional_field(
        "display_as_bot",
        decode.bool,
      )
      use v_edited <- codec.optional_field(
        "edited",
        message.message_edited_decoder(),
      )
      use v_client_msg_id <- codec.optional_field(
        "client_msg_id",
        decode.string,
      )
      use v_bot_id <- codec.optional_field("bot_id", decode.string)
      use v_bot_profile <- codec.optional_field(
        "bot_profile",
        message.bot_profile_decoder(),
      )
      use v_app_id <- codec.optional_field("app_id", decode.string)
      use v_parent_user_id <- codec.optional_field(
        "parent_user_id",
        decode.string,
      )
      use v_metadata <- codec.optional_field(
        "metadata",
        message.message_metadata_decoder(),
      )
      use v_reactions <- codec.optional_field(
        "reactions",
        decode.list(common.reaction_decoder()),
      )
      use v_is_starred <- codec.optional_field("is_starred", decode.bool)
      use v_pinned_to <- codec.optional_field(
        "pinned_to",
        decode.list(decode.string),
      )
      use v_app_context <- codec.optional_field(
        "app_context",
        decode.recursive(app_context_decoder),
      )
      use v_message <- codec.optional_field(
        "message",
        message.message_decoder(),
      )
      use v_hidden <- codec.optional_field("hidden", decode.bool)
      use v_event_ts <- codec.optional_field("event_ts", decode.string)
      decode.success(PlainMessage(
        channel: v_channel,
        user: v_user,
        text: v_text,
        ts: v_ts,
        thread_ts: v_thread_ts,
        channel_type: v_channel_type,
        team: v_team,
        blocks: v_blocks,
        attachments: v_attachments,
        files: v_files,
        upload: v_upload,
        display_as_bot: v_display_as_bot,
        edited: v_edited,
        client_msg_id: v_client_msg_id,
        bot_id: v_bot_id,
        bot_profile: v_bot_profile,
        app_id: v_app_id,
        parent_user_id: v_parent_user_id,
        metadata: v_metadata,
        reactions: v_reactions,
        is_starred: v_is_starred,
        pinned_to: v_pinned_to,
        app_context: v_app_context,
        message: v_message,
        hidden: v_hidden,
        event_ts: v_event_ts,
      ))
    }
    "assistant_app_thread" -> {
      use _ <- decode.optional_field(
        "type",
        "message",
        codec.constant("message"),
      )
      use v_channel <- codec.optional_field("channel", decode.string)
      use v_user <- codec.optional_field("user", decode.string)
      use v_text <- codec.optional_field("text", decode.string)
      use v_ts <- codec.optional_field("ts", decode.string)
      use v_thread_ts <- codec.optional_field("thread_ts", decode.string)
      use v_channel_type <- codec.optional_field(
        "channel_type",
        message_channel_type_decoder(),
      )
      use v_team <- codec.optional_field("team", decode.string)
      use v_blocks <- codec.optional_field(
        "blocks",
        decode.list(block.block_decoder()),
      )
      use v_assistant_app_thread <- codec.optional_field(
        "assistant_app_thread",
        message.assistant_app_thread_info_decoder(),
      )
      use v_event_ts <- codec.optional_field("event_ts", decode.string)
