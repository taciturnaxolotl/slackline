/// The kind of conversation a message event happened in.
pub type MessageChannelType {
  /// A public channel (`message.channels`).
  Channel
  /// A private channel or multi-party DM (`message.groups`).
  Group
  /// A direct message (`message.im`).
  Im
  /// A multi-party direct message (`message.mpim`).
  Mpim
  /// An App Home (`message.app_home`).
  AppHome
  /// A value that this version of slackline does not know.
  UnknownMessageChannelType(String)
}

/// The json string of `MessageChannelType`.
pub fn message_channel_type_to_string(it: MessageChannelType) -> String {
  case it {
    Channel -> "channel"
    Group -> "group"
    Im -> "im"
    Mpim -> "mpim"
    AppHome -> "app_home"
    UnknownMessageChannelType(other) -> other
  }
}

/// Parses `MessageChannelType` from its json string.
pub fn message_channel_type_from_string(string: String) -> MessageChannelType {
  case string {
    "channel" -> Channel
    "group" -> Group
    "im" -> Im
    "mpim" -> Mpim
    "app_home" -> AppHome
    other -> UnknownMessageChannelType(other)
  }
}

/// Decodes `MessageChannelType` from a json string.
pub fn message_channel_type_decoder() -> decode.Decoder(MessageChannelType) {
  decode.map(decode.string, message_channel_type_from_string)
}

/// Encodes `MessageChannelType` as a json string.
pub fn message_channel_type_to_json(it: MessageChannelType) -> json.Json {
  json.string(message_channel_type_to_string(it))
}

