/// Structured metadata attached to a message. Used both when sending (the
/// `metadata` argument of `chat.postMessage`, `chat.update`, `chat.unfurl`
/// and `entity.presentDetails`) and when receiving.
///
/// Event metadata sets `event_type` and `event_payload`. Work Object metadata
/// sets `entities` (for `chat.postMessage` and `chat.unfurl`) or a single
/// `entity_type` and `entity_payload` (for `entity.presentDetails`).
/// See <https://docs.slack.dev/messaging/message-metadata>.
pub type MessageMetadata {
  MessageMetadata(
    /// Identifies the type of event, such as `ticket_created`. Letters,
    /// numbers, underscores and hyphens only. Standard schemas include
    /// `notification` and `approval`.
    event_type: Option(String),
    /// The event-specific fields.
    event_payload: Option(value.Value),
    /// Work Object entities to unfurl or post.
    entities: Option(List(WorkObjectEntity)),
    /// A single Work Object entity type (`entity.presentDetails`).
    entity_type: Option(String),
    /// A single Work Object entity payload (`entity.presentDetails`).
    entity_payload: Option(value.Value),
  )
}

/// Decodes `MessageMetadata` from json.
pub fn message_metadata_decoder() -> decode.Decoder(MessageMetadata) {
  use v_event_type <- codec.optional_field("event_type", decode.string)
  use v_event_payload <- codec.optional_field("event_payload", value.decoder())
  use v_entities <- codec.optional_field(
    "entities",
    decode.list(decode.recursive(work_object_entity_decoder)),
  )
  use v_entity_type <- codec.optional_field("entity_type", decode.string)
  use v_entity_payload <- codec.optional_field(
    "entity_payload",
    value.decoder(),
  )
  decode.success(MessageMetadata(
    event_type: v_event_type,
    event_payload: v_event_payload,
    entities: v_entities,
    entity_type: v_entity_type,
    entity_payload: v_entity_payload,
  ))
}

/// Encodes `MessageMetadata` as json.
pub fn message_metadata_to_json(it: MessageMetadata) -> json.Json {
  codec.object([
    codec.optional("event_type", it.event_type, json.string),
    codec.optional("event_payload", it.event_payload, value.to_json),
    codec.optional(
      "entities",
      it.entities,
      codec.list(work_object_entity_to_json),
    ),
    codec.optional("entity_type", it.entity_type, json.string),
    codec.optional("entity_payload", it.entity_payload, value.to_json),
  ])
}

/// A Work Object entity in message metadata, as sent to `chat.postMessage`,
/// `chat.postEphemeral` and `chat.unfurl`.
/// See <https://docs.slack.dev/messaging/work-objects-implementation>.
pub type WorkObjectEntity {
  WorkObjectEntity(
    /// The entity type, such as `slack#/entities/file` or
    /// `slack#/entities/task`.
    entity_type: String,
    /// Uniquely identifies the resource in the third-party system.
    external_ref: ExternalRef,
    /// The URL that directs the user to the resource in the third-party system.
    url: String,
    /// The properties displayed in the Work Object (`attributes`, `fields`,
    /// `custom_fields`, ...).
    entity_payload: value.Value,
    /// The URL posted by the user in a conversation, as found in the
    /// `link_shared` event. `chat.unfurl` uses it. Posting a message does not
    /// need it.
    app_unfurl_url: Option(String),
    /// Set to `false` to hide the refresh button and opt out of automatic
    /// refreshes.
    is_refreshable: Option(Bool),
    /// A comment summary for the entity.
    entity_comments: Option(EntityComments),
  )
}

/// Decodes `WorkObjectEntity` from json.
pub fn work_object_entity_decoder() -> decode.Decoder(WorkObjectEntity) {
  use v_entity_type <- decode.field("entity_type", decode.string)
  use v_external_ref <- decode.field(
    "external_ref",
    decode.recursive(external_ref_decoder),
  )
  use v_url <- decode.field("url", decode.string)
  use v_entity_payload <- decode.field("entity_payload", value.decoder())
  use v_app_unfurl_url <- codec.optional_field("app_unfurl_url", decode.string)
  use v_is_refreshable <- codec.optional_field("is_refreshable", decode.bool)
  use v_entity_comments <- codec.optional_field(
    "entity_comments",
    decode.recursive(entity_comments_decoder),
  )
  decode.success(WorkObjectEntity(
    entity_type: v_entity_type,
    external_ref: v_external_ref,
    url: v_url,
    entity_payload: v_entity_payload,
    app_unfurl_url: v_app_unfurl_url,
    is_refreshable: v_is_refreshable,
    entity_comments: v_entity_comments,
  ))
}

/// Encodes `WorkObjectEntity` as json.
pub fn work_object_entity_to_json(it: WorkObjectEntity) -> json.Json {
  codec.object([
    codec.field("entity_type", json.string(it.entity_type)),
    codec.field("external_ref", external_ref_to_json(it.external_ref)),
    codec.field("url", json.string(it.url)),
    codec.field("entity_payload", value.to_json(it.entity_payload)),
    codec.optional("app_unfurl_url", it.app_unfurl_url, json.string),
    codec.optional("is_refreshable", it.is_refreshable, json.bool),
    codec.optional(
      "entity_comments",
      it.entity_comments,
      entity_comments_to_json,
    ),
  ])
}

/// Identifies a Work Object resource in the app's own system.
pub type ExternalRef {
  ExternalRef(
    /// A string ID that uniquely identifies the resource. Use the same ID that
    /// your system uses to get the resource through its APIs.
    id: String,
    /// An optional internal type for the entity in the source system. It is
    /// only needed when the ID is not globally unique.
    ref_type: Option(String),
  )
}

/// Decodes `ExternalRef` from json.
pub fn external_ref_decoder() -> decode.Decoder(ExternalRef) {
  use v_id <- decode.field("id", decode.string)
  use v_ref_type <- codec.optional_field("type", decode.string)
  decode.success(ExternalRef(id: v_id, ref_type: v_ref_type))
}

/// Encodes `ExternalRef` as json.
pub fn external_ref_to_json(it: ExternalRef) -> json.Json {
  codec.object([
    codec.field("id", json.string(it.id)),
    codec.optional("type", it.ref_type, json.string),
  ])
}

/// A comment summary shown on a Work Object.
pub type EntityComments {
  EntityComments(
    /// The number of comments on the entity.
    count: Option(Int),
    /// The Unix timestamp of the latest comment.
    latest_timestamp: Option(Int),
  )
}

/// Decodes `EntityComments` from json.
pub fn entity_comments_decoder() -> decode.Decoder(EntityComments) {
  use v_count <- codec.optional_field("count", decode.int)
  use v_latest_timestamp <- codec.optional_field("latest_timestamp", decode.int)
  decode.success(EntityComments(
    count: v_count,
    latest_timestamp: v_latest_timestamp,
  ))
}

/// Encodes `EntityComments` as json.
pub fn entity_comments_to_json(it: EntityComments) -> json.Json {
  codec.object([
    codec.optional("count", it.count, json.int),
    codec.optional("latest_timestamp", it.latest_timestamp, json.int),
  ])
}

/// Metadata for an app event, for the `metadata` argument of
/// `chat.postMessage` and `chat.update`.
///
/// ```gleam
/// message.event_metadata("ticket_created", value.Object([
///   #("ticket_id", value.String("PROJ-1234")),
/// ]))
/// ```
pub fn event_metadata(
  event_type: String,
  event_payload: value.Value,
) -> MessageMetadata {
  MessageMetadata(
    event_type: Some(event_type),
    event_payload: Some(event_payload),
    entities: None,
    entity_type: None,
    entity_payload: None,
  )
}

/// Metadata with Work Object entities, for `chat.postMessage`,
/// `chat.postEphemeral` and `chat.unfurl`.
pub fn entities_metadata(entities: List(WorkObjectEntity)) -> MessageMetadata {
  MessageMetadata(
    event_type: None,
    event_payload: None,
    entities: Some(entities),
    entity_type: None,
    entity_payload: None,
  )
}

/// Metadata with one Work Object entity type and payload, for the flexpane
/// of `entity.presentDetails`.
pub fn entity_details_metadata(
  entity_type: String,
  entity_payload: value.Value,
) -> MessageMetadata {
  MessageMetadata(
    event_type: None,
    event_payload: None,
    entities: None,
    entity_type: Some(entity_type),
    entity_payload: Some(entity_payload),
  )
}

/// A Work Object entity from its required fields. `external_id` is the ID of
/// the resource in your system. Set the optional fields with record update
/// syntax.
pub fn work_object_entity(
  entity_type entity_type: String,
  external_id external_id: String,
  url url: String,
  entity_payload entity_payload: value.Value,
) -> WorkObjectEntity {
  WorkObjectEntity(
    entity_type:,
    external_ref: ExternalRef(id: external_id, ref_type: None),
    url:,
    entity_payload:,
    app_unfurl_url: None,
    is_refreshable: None,
    entity_comments: None,
  )
}
