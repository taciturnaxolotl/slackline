/// Function or workflow parameters. Manifest v2 uses `{properties, required}`.
/// v1 uses a map of parameters, each with `is_required`.
pub type ParameterSchema {
  ParametersV2(ParameterProperties)
  ParametersV1(dict.Dict(String, Parameter))
}

/// Decodes `ParameterSchema` from json. It tries each alternative in order.
pub fn parameter_schema_decoder() -> decode.Decoder(ParameterSchema) {
  decode.one_of(
    decode.map(decode.recursive(parameter_properties_decoder), ParametersV2),
    [
      decode.map(
        decode.dict(decode.string, decode.recursive(parameter_decoder)),
        ParametersV1,
      ),
    ],
  )
}

/// Encodes `ParameterSchema` as json.
pub fn parameter_schema_to_json(it: ParameterSchema) -> json.Json {
  case it {
    ParametersV2(inner) -> parameter_properties_to_json(inner)
    ParametersV1(inner) -> codec.dict(parameter_to_json)(inner)
  }
}

