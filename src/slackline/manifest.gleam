/// How the app authenticates to an MCP server.
pub type McpAuthType {
  /// `dynamic_client_registration`
  DynamicClientRegistration
  /// `no_auth`
  NoAuth
  /// `manual_auth`
  ManualAuth
  /// `slack_identity_auth`
  SlackIdentityAuth
  /// A value that this version of slackline does not know.
  UnknownMcpAuthType(String)
}

/// The json string of `McpAuthType`.
pub fn mcp_auth_type_to_string(it: McpAuthType) -> String {
  case it {
    DynamicClientRegistration -> "dynamic_client_registration"
    NoAuth -> "no_auth"
    ManualAuth -> "manual_auth"
    SlackIdentityAuth -> "slack_identity_auth"
    UnknownMcpAuthType(other) -> other
  }
}

/// Parses `McpAuthType` from its json string.
pub fn mcp_auth_type_from_string(string: String) -> McpAuthType {
  case string {
    "dynamic_client_registration" -> DynamicClientRegistration
    "no_auth" -> NoAuth
    "manual_auth" -> ManualAuth
    "slack_identity_auth" -> SlackIdentityAuth
    other -> UnknownMcpAuthType(other)
  }
}

/// Decodes `McpAuthType` from a json string.
pub fn mcp_auth_type_decoder() -> decode.Decoder(McpAuthType) {
  decode.map(decode.string, mcp_auth_type_from_string)
}

/// Encodes `McpAuthType` as a json string.
pub fn mcp_auth_type_to_json(it: McpAuthType) -> json.Json {
  json.string(mcp_auth_type_to_string(it))
}

