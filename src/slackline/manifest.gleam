/// One external OAuth provider.
pub type ExternalAuthProvider {
  ExternalAuthProvider(
    /// `CUSTOM` or `SLACK_PROVIDED`.
    provider_type: ProviderType,
    options: ExternalAuthOptions,
  )
}

/// Decodes `ExternalAuthProvider` from json.
pub fn external_auth_provider_decoder() -> decode.Decoder(ExternalAuthProvider) {
  use v_provider_type <- decode.field("provider_type", provider_type_decoder())
  use v_options <- decode.field(
    "options",
    decode.recursive(external_auth_options_decoder),
  )
  decode.success(ExternalAuthProvider(
    provider_type: v_provider_type,
    options: v_options,
  ))
}

/// Encodes `ExternalAuthProvider` as json.
pub fn external_auth_provider_to_json(it: ExternalAuthProvider) -> json.Json {
  codec.object([
    codec.field("provider_type", provider_type_to_json(it.provider_type)),
    codec.field("options", external_auth_options_to_json(it.options)),
  ])
}

/// The kind of external auth provider.
pub type ProviderType {
  /// `CUSTOM`
  CustomProvider
  /// `SLACK_PROVIDED`
  SlackProvidedProvider
  /// A value that this version of slackline does not know.
  UnknownProviderType(String)
}

/// The json string of `ProviderType`.
pub fn provider_type_to_string(it: ProviderType) -> String {
  case it {
    CustomProvider -> "CUSTOM"
    SlackProvidedProvider -> "SLACK_PROVIDED"
    UnknownProviderType(other) -> other
  }
}

/// Parses `ProviderType` from its json string.
pub fn provider_type_from_string(string: String) -> ProviderType {
  case string {
    "CUSTOM" -> CustomProvider
    "SLACK_PROVIDED" -> SlackProvidedProvider
    other -> UnknownProviderType(other)
  }
}

/// Decodes `ProviderType` from a json string.
pub fn provider_type_decoder() -> decode.Decoder(ProviderType) {
  decode.map(decode.string, provider_type_from_string)
}

/// Encodes `ProviderType` as a json string.
pub fn provider_type_to_json(it: ProviderType) -> json.Json {
  json.string(provider_type_to_string(it))
}

/// External auth provider options. `SLACK_PROVIDED` only uses `client_id` and
/// `scope`.
pub type ExternalAuthOptions {
  ExternalAuthOptions(
    /// Max 1024 characters.
    client_id: String,
    /// Scopes to request.
    scope: List(String),
    /// Required for `CUSTOM`. Max 255 characters.
    provider_name: Option(String),
    /// Required for `CUSTOM`. An `https://` URL.
    authorization_url: Option(String),
    /// Required for `CUSTOM`. An `https://` URL.
    token_url: Option(String),
    /// Extra query parameters for the authorization URL.
    authorization_url_extras: Option(dict.Dict(String, String)),
    /// Required for `CUSTOM`.
    identity_config: Option(IdentityConfig),
    /// Whether this provider uses PKCE.
    use_pkce: Option(Bool),
    token_url_config: Option(TokenUrlConfig),
  )
}

/// Decodes `ExternalAuthOptions` from json.
pub fn external_auth_options_decoder() -> decode.Decoder(ExternalAuthOptions) {
  use v_client_id <- decode.field("client_id", decode.string)
  use v_scope <- decode.field("scope", decode.list(decode.string))
  use v_provider_name <- codec.optional_field("provider_name", decode.string)
  use v_authorization_url <- codec.optional_field(
    "authorization_url",
    decode.string,
  )
  use v_token_url <- codec.optional_field("token_url", decode.string)
  use v_authorization_url_extras <- codec.optional_field(
    "authorization_url_extras",
    decode.dict(decode.string, decode.string),
  )
  use v_identity_config <- codec.optional_field(
    "identity_config",
    decode.recursive(identity_config_decoder),
  )
  use v_use_pkce <- codec.optional_field("use_pkce", decode.bool)
  use v_token_url_config <- codec.optional_field(
    "token_url_config",
    decode.recursive(token_url_config_decoder),
  )
  decode.success(ExternalAuthOptions(
    client_id: v_client_id,
    scope: v_scope,
    provider_name: v_provider_name,
    authorization_url: v_authorization_url,
    token_url: v_token_url,
    authorization_url_extras: v_authorization_url_extras,
    identity_config: v_identity_config,
    use_pkce: v_use_pkce,
    token_url_config: v_token_url_config,
  ))
}

/// Encodes `ExternalAuthOptions` as json.
pub fn external_auth_options_to_json(it: ExternalAuthOptions) -> json.Json {
  codec.object([
    codec.field("client_id", json.string(it.client_id)),
    codec.field("scope", json.array(it.scope, json.string)),
    codec.optional("provider_name", it.provider_name, json.string),
    codec.optional("authorization_url", it.authorization_url, json.string),
    codec.optional("token_url", it.token_url, json.string),
    codec.optional(
      "authorization_url_extras",
      it.authorization_url_extras,
      codec.dict(json.string),
    ),
    codec.optional(
      "identity_config",
      it.identity_config,
      identity_config_to_json,
    ),
    codec.optional("use_pkce", it.use_pkce, json.bool),
    codec.optional(
      "token_url_config",
      it.token_url_config,
      token_url_config_to_json,
    ),
  ])
}

