//// Assembles generated modules: decides which module every method goes in,
//// renders the items and methods of each module, and adds the hand-written
//// `.extra.gleam` code.

import gleam/bool
import gleam/dict.{type Dict}
import gleam/int
import gleam/list
import gleam/option.{type Option, None, Some}
import gleam/result
import gleam/set.{type Set}
import gleam/string
import slackline_codegen/generate/examples
import slackline_codegen/generate/fields.{type PField}
import slackline_codegen/generate/imports
import slackline_codegen/generate/ir.{
  type DocsMethod, type ExampleCase, type Item, type Method, type Module,
}
import slackline_codegen/generate/names
import slackline_codegen/generate/registry.{type Registry}
import slackline_codegen/generate/render_builders
import slackline_codegen/generate/render_methods
import slackline_codegen/generate/render_types
import slackline_codegen/generate/schema
import slackline_codegen/generate/types.{type Output}

pub const marker =
  "//// This module is generated by `gleam run -m slackline_codegen/generate`. Do not edit it by hand."

/// Everything the generator reads.
pub type Inputs {
  Inputs(
    /// `.sls` files as `#(path, contents)`, sorted by path.
    specs: List(#(String, String)),
    /// `.extra.gleam` contents by path.
    extras: Dict(String, String),
    methods: List(DocsMethod),
  )
}

pub type Built {
  Built(
    /// Generated files as `#(file path, source)`, sorted by path. The
    /// sources are not formatted yet.
    files: List(#(String, String)),
    /// Method name to the spec that declares it.
    placement: Dict(String, Method),
  )
}

/// Parses every spec and checks that module paths are valid and unique.
pub fn load(specs: List(#(String, String))) -> Result(List(Module), String) {
  list.try_fold(specs, [], fn(modules, spec) {
    let #(file, text) = spec
    use module <- result.try(schema.parse(text, file))
    let segments = string.split(module.path, "/")
    use <- bool.lazy_guard(!list.all(segments, names.is_lower_name), fn() {
      let hint = segments |> list.map(names.snake) |> string.join("/")
      Error(
        file
        <> ": module path "
        <> module.path
        <> " is not valid Gleam, write `module "
        <> hint
        <> "`",
      )
    })
    case list.find(modules, fn(other: Module) { other.path == module.path }) {
      Ok(other) ->
        Error(
          file
          <> ": module "
          <> module.path
          <> " already declared in "
          <> other.file,
        )
      Error(Nil) -> Ok([module, ..modules])
    }
  })
  |> result.map(list.reverse)
}

/// Error codes almost every method can return (auth, rate limits, malformed
/// requests). Method docs leave them out of "Documented errors". The list is
/// a constant so the generated docs do not change when the docs add or drop
/// methods.
pub const generic_errors = [
  "access_denied", "accesslimited", "account_inactive", "deprecated_endpoint",
  "ekm_access_denied", "enterprise_is_restricted", "fatal_error",
  "internal_error", "invalid_arg_name", "invalid_arguments", "invalid_array_arg",
  "invalid_auth", "invalid_charset", "invalid_form_data", "invalid_post_type",
  "method_deprecated", "missing_argument", "missing_post_type", "missing_scope",
  "no_permission", "not_allowed_token_type", "not_authed", "org_login_required",
  "ratelimited", "request_timeout", "service_unavailable",
  "team_access_not_granted", "team_added_to_org", "token_expired",
  "token_revoked", "two_factor_setup_required",
]

pub fn build(inputs: Inputs) -> Result(Built, String) {
  use modules <- result.try(load(inputs.specs))
  use registry <- result.try(registry.from_modules(modules))
  let docs_names = set.from_list(list.map(inputs.methods, fn(m) { m.name }))
  use placement <- result.try(
    list.try_fold(modules, dict.new(), fn(placement, module) {
      list.try_fold(module.methods, placement, fn(placement, method) {
        let ir.Method(name:, file:, ..) = method
        case set.contains(docs_names, name), dict.get(placement, name) {
          False, _ ->
            Error(file <> ": method " <> name <> " is not in spec/methods.json")
          _, Ok(_) -> Error(file <> ": method " <> name <> " declared twice")
          _, _ -> Ok(dict.insert(placement, name, #(module.path, method)))
        }
      })
    }),
  )
  let by_module =
    list.fold(list.reverse(inputs.methods), dict.new(), fn(by_module, method) {
      let #(path, spec) = case dict.get(placement, method.name) {
        Ok(#(path, spec)) -> #(path, Some(spec))
        Error(Nil) -> #(render_methods.default_module(method.name), None)
      }
      dict.upsert(by_module, path, fn(existing) {
        [#(method, spec), ..option.unwrap(existing, [])]
      })
    })
  let by_path =
    dict.from_list(list.map(modules, fn(module) { #(module.path, module) }))
  let paths =
    list.append(dict.keys(by_path), dict.keys(by_module))
    |> list.unique
    |> list.sort(string.compare)
  let context = Context(registry:, generic: set.from_list(generic_errors))
  use rendered <- result.try(
    list.try_map(paths, fn(path) {
      let module = option.from_result(dict.get(by_path, path))
      let extra =
        module
        |> option.then(fn(module) {
          option.from_result(dict.get(inputs.extras, extra_path(module.file)))
        })
        |> option.unwrap("")
      let methods = dict.get(by_module, path) |> result.unwrap([])
      render_module(path, module, methods, extra, context)
    }),
  )
  let outputs = merge(list.flat_map(rendered, fn(r) { r.0 }))
  let tests = examples.render(list.flat_map(rendered, fn(r) { r.1 }), registry)
  let files =
    list.map(outputs, fn(output) {
      #("src/" <> output.path <> ".gleam", assemble(output))
    })
    |> list.append([#(examples.test_path, assemble(tests))])
  Ok(Built(
    files: list.sort(files, fn(a, b) { string.compare(a.0, b.0) }),
    placement: dict.map_values(placement, fn(_, entry) { entry.1 }),
  ))
}

type Context {
  Context(registry: Registry, generic: Set(String))
}

/// Joins the outputs for the same module, such as the builders of a union
/// and the module that declares the union. Setter and attribute modules are
/// named after functions, so two of them can also collide with a module.
fn merge(outputs: List(Output)) -> List(Output) {
  // `list.group` keeps each group in reverse order.
  let groups = list.group(outputs, fn(output) { output.path })
  outputs
  |> list.map(fn(output) { output.path })
  |> list.unique
  |> list.filter_map(fn(path) { dict.get(groups, path) })
  |> list.filter_map(fn(group) { list.reduce(list.reverse(group), join) })
}

fn join(first: Output, second: Output) -> Output {
  types.Output(
    ..first,
    docs: case first.docs {
      "" -> second.docs
      docs -> docs
    },
    chunks: list.append(first.chunks, second.chunks),
  )
}

/// `spec/types/block.sls` keeps its hand-written code in
/// `spec/types/block.extra.gleam`.
pub fn extra_path(spec_file: String) -> String {
  string.drop_end(spec_file, string.length(".sls")) <> ".extra.gleam"
}

fn constructor_names(item: Item) -> List(String) {
  case item {
    ir.RecordItem(record) -> [record.name]
    ir.UnionItem(union) ->
      list.append(list.map(union.variants, fn(v) { v.name }), [
        union.unknown.name,
      ])
    ir.EnumItem(enum) ->
      list.append(
        list.map(enum.values, fn(v) {
          option.lazy_unwrap(v.name, fn() { names.pascal(v.value) })
        }),
        option.map(enum.unknown, fn(u) { [u.name] }) |> option.unwrap([]),
      )
    ir.OneofItem(oneof) -> list.map(oneof.variants, fn(v) { v.name })
  }
}

fn check_constructors(path: String, items: List(Item)) -> Result(Nil, String) {
  let builtin =
    list.append(registry.builtin_names, [
      "Ok", "Error", "True", "False", "None", "Some",
    ])
  list.try_fold(items, dict.new(), fn(seen, item) {
    let context =
      ir.item_file(item) <> ": constructor {} in " <> ir.item_name(item)
    list.try_fold(constructor_names(item), seen, fn(seen, ctor) {
      let context = string.replace(context, "{}", ctor)
      case list.contains(builtin, ctor), dict.get(seen, ctor) {
        True, _ -> Error(context <> " shadows a Gleam builtin")
        _, Ok(other) ->
          Error(context <> " clashes with " <> other <> " in module " <> path)
        _, _ -> Ok(dict.insert(seen, ctor, ir.item_name(item)))
      }
    })
  })
  |> result.replace(Nil)
}

fn method_function(
  path: String,
  method: #(DocsMethod, Option(Method)),
) -> String {
  case method.1 {
    Some(ir.Method(function: Some(function), ..)) -> function
    _ -> render_methods.function_name({ method.0 }.name, path)
  }
}

/// The outputs for one module path (the module, its setter modules and its
/// builder modules) and the response examples to test.
fn render_module(
  path: String,
  module: Option(Module),
  methods: List(#(DocsMethod, Option(Method))),
  extra: String,
  context: Context,
) -> Result(#(List(Output), List(ExampleCase)), String) {
  let registry = context.registry
  let items =
    option.map(module, fn(module) { module.items }) |> option.unwrap([])
  use Nil <- result.try(check_constructors(path, items))
  let functions = list.map(methods, method_function(path, _))
  let referenced =
    list.append(
      list.flat_map(items, registry.referenced_types),
      list.flat_map(methods, fn(m) {
        option.map(m.1, registry.method_types) |> option.unwrap([])
      }),
    )
    |> registry.referenced_paths(registry, _, path)
  let aliases =
    registry.allocate_aliases(
      [types.value_module, types.codec_module, "slackline", ..referenced],
      set.from_list(functions),
    )
  let scope = types.Scope(path, registry, aliases)
  let taken =
    list.map(items, ir.item_name)
    |> list.append(list.map(functions, fn(f) { names.pascal(f) <> "Response" }))
    |> list.append(registry.builtin_names)
    |> set.from_list
  let phantom = fn(function) {
    let name = names.pascal(function)
    case set.contains(taken, name) {
      True -> name <> "Method"
      False -> name
    }
  }
  use type_chunks <- result.try(
    list.try_map(items, render_types.render(_, scope)),
  )
  use Nil <- result.try(unique_functions(path, methods, functions))
  use rendered <- result.try(
    list.try_map(list.zip(methods, functions), fn(entry) {
      let #(#(docs, spec), function) = entry
      use rendered <- result.try(render_methods.render(
        docs,
        spec,
        function,
        phantom(function),
        scope,
        context.generic,
      ))
      use setter <- result.map(setter_module(
        path,
        docs,
        function,
        phantom(function),
        rendered,
        registry,
      ))
      #(rendered, setter)
    }),
  )
  let method_chunks = list.map(rendered, fn(entry) { { entry.0 }.lines })
  let setter_modules =
    list.filter_map(rendered, fn(entry) { option.to_result(entry.1, Nil) })
  let examples =
    list.filter_map(rendered, fn(entry) {
      option.to_result({ entry.0 }.example, Nil)
    })
  use builder_outputs <- result.try(
    list.try_map(items, fn(item) {
      case item {
        ir.UnionItem(ir.Union(builders: Some(_), ..) as union) ->
          render_builders.render(union, scope, registry)
        _ -> Ok([])
      }
    }),
  )
  let docs = case module {
    Some(module) if module.docs != [] -> string.join(module.docs, "\n")
    _ ->
      "Slack Web API methods under `"
      <> {
        path |> string.replace("slackline/api/", "") |> string.replace("/", ".")
      }
      <> "`."
  }
  let has_builders =
    list.any(items, fn(item) {
      case item {
        ir.UnionItem(ir.Union(builders: Some(_), ..)) -> True
        _ -> False
      }
    })
  let attr_chunks = case has_builders {
    True -> [render_builders.attr_lines()]
    False -> []
  }
  let main =
    types.Output(
      path:,
      docs:,
      chunks: list.flatten([type_chunks, attr_chunks, method_chunks]),
      aliases:,
      extra:,
    )
  Ok(#(
    list.flatten([[main], setter_modules, list.flatten(builder_outputs)]),
    examples,
  ))
}

/// Fails when two methods of a module get the same function name.
fn unique_functions(
  path: String,
  methods: List(#(DocsMethod, Option(Method))),
  functions: List(String),
) -> Result(Nil, String) {
  list.zip(methods, functions)
  |> list.try_fold(set.new(), fn(used, entry) {
    let #(#(docs, _), function) = entry
    case set.contains(used, function) {
      True ->
        Error(
          path
          <> ": function name "
          <> function
          <> " used twice ("
          <> docs.name
          <> ")",
        )
      False -> Ok(set.insert(used, function))
    }
  })
  |> result.replace(Nil)
}

/// The source of a generated module: the marker, the module docs, the
/// imports the body needs, the chunks and the hand-written code.
pub fn assemble(output: Output) -> String {
  let #(extra_imports, extra_body) = split_extra(output.extra)
  let body = list.append(list.flatten(output.chunks), extra_body)
  let chunks = case extra_body {
    [] -> output.chunks
    _ -> list.append(output.chunks, [extra_body])
  }
  list.flatten([
    [marker, "////"],
    names.module_doc_lines(output.docs),
    [""],
    imports.lines(output.path, output.aliases, body, extra_imports),
    [""],
    list.flat_map(chunks, fn(chunk) { ["", ..chunk] }),
  ])
  |> string.join("\n")
}

/// The module of setters for the optional arguments of a method, if it has
/// any.
fn setter_module(
  family: String,
  docs: DocsMethod,
  function: String,
  phantom: String,
  rendered: render_methods.Rendered,
  registry: Registry,
) -> Result(Option(Output), String) {
  use <- bool.guard(rendered.optional == [], Ok(None))
  let optional = rendered.optional
  let path = render_methods.setter_path(family, function)
  let referenced =
    list.flat_map(optional, fn(field) {
      case field {
        fields.PField(type_:, ..) -> types.paths(type_)
        fields.PConst(..) -> []
      }
    })
  let reserved =
    set.from_list(list.map(optional, fields.gleam_name)) |> set.insert("call")
  let aliases =
    registry.allocate_aliases(
      [
        family,
        types.value_module,
        types.codec_module,
        "slackline",
        ..referenced
      ],
      reserved,
    )
  let scope = types.Scope(path, registry, aliases)
  let family_alias = registry.alias(aliases, family)
  use body <- result.map(render_methods.setter_lines(
    optional,
    family_alias <> "." <> phantom,
    scope,
  ))
  let call =
    family_alias
    <> "."
    <> function
    <> "("
    <> string.join(
      list.map(rendered.required, fn(field) {
        fields.gleam_name(field) <> ": " <> example_value(field, docs)
      }),
      ", ",
    )
    <> ")"
  // A setter module named like a standard library module (`list`) needs
  // another import name, such as `conversations_list`.
  let #(setter_alias, import_line) = case
    list.contains(stdlib_modules, names.alias_of(path))
  {
    True -> {
      let alias = family_alias <> "_" <> names.alias_of(path)
      #(alias, "import " <> path <> " as " <> alias <> "\n\n")
    }
    False -> #(names.alias_of(path), "")
  }
  // The example uses the first setter that is not legacy or deprecated.
  let headline =
    list.find(optional, fn(field) { !is_legacy(field.docs) })
    |> result.lazy_or(fn() { list.first(optional) })
  let setter = case headline {
    Ok(first) ->
      "|> "
      <> setter_alias
      <> "."
      <> fields.gleam_name(first)
      <> "("
      <> example_value(first, docs)
      <> ")"
    Error(Nil) -> ""
  }
  let docs =
    "Setters for the optional arguments of [`"
    <> docs.name
    <> "`]("
    <> docs.url
    <> "). Each setter takes the call that `"
    <> family_alias
    <> "."
    <> function
    <> "` returns and sets one argument:\n\n```gleam\n"
    <> import_line
    <> call
    <> "\n"
    <> setter
    <> "\n```"
  Some(types.Output(path:, docs:, chunks: [body], aliases:, extra: ""))
}

/// Whether argument docs mark the argument as legacy or deprecated.
fn is_legacy(docs: String) -> Bool {
  let docs = string.trim_start(docs)
  string.starts_with(docs, "(Legacy)") || string.starts_with(docs, "Deprecated")
}

/// Standard library modules that a setter module can share a name with.
const stdlib_modules = [
  "list", "dict", "set", "option", "result", "string", "int", "float", "bool",
  "order", "function", "uri",
]

/// A value for an argument in a doc example: the example from the docs when
/// it fits the type, else a placeholder named after the argument.
fn example_value(field: PField, docs: DocsMethod) -> String {
  let name = fields.gleam_name(field)
  let example =
    list.find(docs.args, fn(arg) { arg.name == field.key })
    |> result.try(fn(arg) { option.to_result(arg.example, Nil) })
    |> result.map(string.trim)
    |> result.unwrap("")
  case field {
    fields.PField(type_: types.RString, ..) ->
      case example == "" || string.length(example) > 40 {
        True -> names.gleam_string(name)
        False -> names.gleam_string(example)
      }
    fields.PField(type_: types.RInt, ..) ->
      int.parse(example) |> result.map(int.to_string) |> result.unwrap("10")
    fields.PField(type_: types.RBool, ..) ->
      case example {
        "false" -> "False"
        _ -> "True"
      }
    _ -> name
  }
}

/// Splits an `.extra.gleam` file into its leading imports and the rest. An
/// import that spans lines (`import x.{\n  a,\n}`) becomes one line.
pub fn split_extra(text: String) -> #(List(String), List(String)) {
  split_imports(string.split(string.trim_end(text), "\n"), [])
}

fn split_imports(
  lines: List(String),
  imports: List(String),
) -> #(List(String), List(String)) {
  case lines {
    [line, ..rest] ->
      case string.starts_with(line, "import "), string.trim(line) {
        _, "" -> split_imports(rest, imports)
        True, _ -> {
          let #(import_, rest) = whole_import(line, rest)
          split_imports(rest, [import_, ..imports])
        }
        False, _ -> #(list.reverse(imports), lines)
      }
    [] -> #(list.reverse(imports), [])
  }
}

/// Joins the lines of an import until its `{` closes.
fn whole_import(line: String, rest: List(String)) -> #(String, List(String)) {
  case string.contains(line, "{") && !string.contains(line, "}"), rest {
    True, [next, ..rest] -> whole_import(line <> " " <> string.trim(next), rest)
    _, _ -> #(line, rest)
  }
}
